  "file_specifications": {
    ".track": {
      "description": "Raw GPS trajectory observations",
      "columns": [
        "longitude",
        "latitude",
        "timestamp"
      ],
      "units": [
        "degrees_east",
        "degrees_north",
        "seconds"
      ],
      "format": "whitespace-separated, headerless"
    },
    ".nodes": {
      "description": "Road network vertex positions (0-based row index = node_id)",
      "columns": [
        "longitude",
        "latitude"
      ],
      "units": [
        "degrees_east",
        "degrees_north"
      ],
      "format": "whitespace-separated, headerless"
    },
    ".arcs": {
      "description": "Directed road network segments (0-based row index = arc_id)",
      "columns": [
        "from_node_id",
        "to_node_id"
      ],
      "types": [
        "int",
        "int"
      ],
      "format": "whitespace-separated, headerless"
    },
    ".route": {
      "description": "Chronological ground-truth sequence of traversed arc_ids",
      "columns": [
        "arc_id"
      ],
      "types": [
        "int"
      ],
      "format": "single-column integer, headerless"
    }
  },
